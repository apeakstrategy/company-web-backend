NODE_ENV=development
PORT=5000
DATABASE_URL="mysql://apeak_user:change_this_password@127.0.0.1:3306/apeak_strategy"
CORS_ORIGINS=http://localhost:3000,https://example.com,https://www.example.com
TRUST_PROXY=false
RATE_LIMIT_MAX=300
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRES_IN=8h
ADMIN_SEED_NAME=Site Administrator
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=replace_with_a_strong_password

# Keep these for Firebase features such as future push notifications.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP account from Hostinger Email, Brevo, Postmark, or another transactional provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=A Peak Strategy
MAIL_FROM_ADDRESS=hello@example.com
MAIL_REPLY_ADDRESS=hello@example.com
CONTACT_NOTIFICATION_TO=hello@example.com
ADMIN_APP_URL=http://localhost:5173
SEND_CONTACT_CONFIRMATION=true
CONTACT_IP_HASH_SECRET=replace_with_a_separate_random_secret
TURNSTILE_SECRET_KEY=
